{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quantitative.local/schema/written.schema.json",
  "title": "Big Exam: written part (content/exams/<topic-id>.written.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "topicId", "title", "durationMinutes", "totalMarks", "instructions", "questions"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "topicId": { "type": "string", "pattern": "^[a-z0-9]+$", "description": "id in src/data/topics.json; must equal the file name prefix" },
    "placeholder": { "type": "boolean", "description": "true on example files that must be replaced before real use" },
    "title": { "type": "string", "minLength": 1 },
    "durationMinutes": { "type": "integer", "minimum": 15, "maximum": 300, "description": "soft limit, about 120" },
    "totalMarks": { "type": "number", "exclusiveMinimum": 0, "description": "must equal the sum of the question marks" },
    "instructions": { "type": "string", "minLength": 1, "description": "Markdown + LaTeX shown above the questions" },
    "preamble": { "type": "string", "description": "optional \\newcommand lines; they apply to question text and to the student's answer preview" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "text", "marks", "parts"],
        "properties": {
          "id": { "type": "string", "pattern": "^q[0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1, "description": "shared setup of the question, Markdown + LaTeX" },
          "marks": { "type": "number", "exclusiveMinimum": 0, "description": "must equal the sum of the part marks" },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text", "marks", "markingScheme", "modelAnswer"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z]$|^[a-z][ivx]+$", "description": "a, b, c ... (or ai, aii for sub-sub-parts)" },
                "text": { "type": "string", "minLength": 1 },
                "marks": { "type": "number", "exclusiveMinimum": 0 },
                "type": { "enum": ["calculation", "derivation", "proof", "explanation", "other"] },
                "markingScheme": {
                  "type": "array",
                  "minItems": 1,
                  "description": "mark allocation per step; the step marks must add up to the part marks",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["step", "marks"],
                    "properties": {
                      "step": { "type": "string", "minLength": 1 },
                      "marks": { "type": "number", "exclusiveMinimum": 0 }
                    }
                  }
                },
                "modelAnswer": { "type": "string", "minLength": 1, "description": "full worked answer, Markdown + LaTeX" }
              }
            }
          }
        }
      }
    }
  }
}
